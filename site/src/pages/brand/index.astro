  .bg-flow code { background: #4a1010; padding: 1px 6px; border-radius: 3px; font-family: var(--mono); font-size: 0.92em; color: #ffd0d0; }

  @media (max-width: 640px) {
    .bg-dd { grid-template-columns: 1fr; }
    .bg-inuse { flex-direction: column; }
    .bg-inuse-card, .bg-inuse-pcard { width: 100%; max-width: 280px; }
  }
</style>

<script>
  function hexToRgb(hex: string): [number, number, number] {
    const h = hex.trim().replace('#', '');
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }
  // WCAG 相對亮度用的門檻是 0.03928（規範自己這樣寫，跟真正的 sRGB EOTF 門檻 0.04045 不同），
  // 對比度計算沿用 WCAG 的定義，OKLab 轉換另外用標準 sRGB 門檻，兩邊故意不共用同一個函式。
  function linWcag(c: number) {
    c /= 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  }
  function luminance([r, g, b]: [number, number, number]) {
    return 0.2126 * linWcag(r) + 0.7152 * linWcag(g) + 0.0722 * linWcag(b);
  }
  function contrast(a: [number, number, number], b: [number, number, number]) {
    const la = luminance(a), lb = luminance(b);
    const hi = Math.max(la, lb), lo = Math.min(la, lb);
    return (hi + 0.05) / (lo + 0.05);
  }

  function srgbToLinear(c: number) {
    c /= 255;
    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  }
  function rgbToOklch([r, g, b]: [number, number, number]) {
    const rl = srgbToLinear(r), gl = srgbToLinear(g), bl = srgbToLinear(b);
    const l = 0.4122214708 * rl + 0.5363325363 * gl + 0.0514459929 * bl;
    const m = 0.2119034982 * rl + 0.6806995451 * gl + 0.1073969566 * bl;
    const s = 0.0883024619 * rl + 0.2817188376 * gl + 0.6299787005 * bl;
    const l_ = Math.cbrt(l), m_ = Math.cbrt(m), s_ = Math.cbrt(s);
    const L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_;
    const a = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_;
    const b2 = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_;
    const C = Math.hypot(a, b2);
    let H = (Math.atan2(b2, a) * 180) / Math.PI;
    if (H < 0) H += 360;
    return { L, C, H };
  }

  function resolveVar(name: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || '#000000';
  }
  function resolveToken(nameNoPrefix: string): string {
    return resolveVar('--' + nameNoPrefix);
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 1) 每個色塊的 hex / OKLCH 文字
    document.querySelectorAll<HTMLElement>('[data-hex]').forEach((el) => {
      const hex = resolveVar(el.dataset.hex!);
      el.textContent = hex;
    });
    document.querySelectorAll<HTMLElement>('[data-oklch]').forEach((el) => {
      const hex = resolveVar(el.dataset.oklch!);
      const { L, C, H } = rgbToOklch(hexToRgb(hex));
      el.textContent = `L${L.toFixed(2)} C${C.toFixed(2)} H${H.toFixed(0)}°`;
    });

    // 2) 對比矩陣表格
    document.querySelectorAll<HTMLElement>('tr[data-fg][data-bg]').forEach((row) => {
      const fg = hexToRgb(resolveToken(row.dataset.fg!));
      const bg = hexToRgb(resolveToken(row.dataset.bg!));
      const ratio = contrast(fg, bg);
      const ratioCell = row.querySelector<HTMLElement>('.bg-ratio-cell')!;
      const passCell = row.querySelector<HTMLElement>('.bg-pass-cell')!;
      ratioCell.textContent = ratio.toFixed(2) + ':1';
      const pass = ratio >= 4.5;
      passCell.textContent = pass ? '✓ 過' : '✕ 不過';
      passCell.className = 'bg-pass-cell ' + (pass ? 'pass' : 'fail');
    });

    // 3) Do/Don't 示範色塊右下角的比值
    document.querySelectorAll<HTMLElement>('.bg-dd-demo[data-fg][data-bg]').forEach((el) => {
      const fg = hexToRgb(resolveToken(el.dataset.fg!));
      const bg = hexToRgb(resolveToken(el.dataset.bg!));
      const ratio = contrast(fg, bg);
      el.setAttribute('data-ratio', ratio.toFixed(2) + ':1');
    });

    // 4) sub-nav scroll-spy——目前捲到哪個 section 就亮哪個連結
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.bg-subnav a'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('h2.sec[id]'));
    if (navLinks.length && sections.length) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.id;
            navLinks.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === `#${id}`));
          });
        },
        { rootMargin: '-96px 0px -75% 0px', threshold: 0 }
      );
      sections.forEach((s) => io.observe(s));
    }
  });
</script>
