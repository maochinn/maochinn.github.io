---
import Layout from '../../layouts/Layout.astro';

// 每個 token 在畫面上的角色說明。真正的色值一律不寫死——頁面載入後由 <script>
// 讀 :root 的 CSS 變數即時算出 hex/OKLCH/對比度，這樣改 global.css（或用右下角
// 🎨 TokenLab 現場試色）此頁的數字會跟著變，永遠不會跟真正上線的顏色兜不起來。

// 頁內導覽——仿 Meta/Google 品牌資源站的 sticky sub-nav，id 對應下面各 h2.sec
const SECTIONS: { id: string; label: string }[] = [
  { id: 'hero', label: '品牌色' },
  { id: 'architecture', label: '架構' },
  { id: 'dna', label: '調性' },
  { id: 'ratio', label: '比例' },
  { id: 'scale', label: '色階' },
  { id: 'neutrals', label: '中性色' },
  { id: 'gold', label: '金色驗算' },
  { id: 'inuse', label: '實際應用' },
  { id: 'oklch', label: '感知驗算' },
  { id: 'contrast', label: '對比矩陣' },
  { id: 'dodont', label: "Do/Don't" },
  { id: 'optionb', label: 'Option B' },
  { id: 'backlog', label: '待收編' },
  { id: 'workflow', label: '工作流程' },
];

// Primitive 色階編號——仿 Tailwind/Radix 的數字系統（越大越深）。
// 100–500 之間留白：card 跟 chip-hi 之間目前沒有中間色階，故意不硬塞。
const RAMP: { v: string; num: number; role: string; note: string }[] = [
  { v: '--accent-hi', num: 950, role: '卡片 hover（最深）', note: '.g-card / .p-card 文字 hover 色' },
  { v: '--mut-card', num: 900, role: '卡片次要文字', note: '卡片（--card）背景上的說明文字、次要資訊' },
  { v: '--bg', num: 800, role: '品牌錨點・頁面主牆', note: '哥德紅本體，見上方 Hero Colors' },
  { v: '--panel', num: 700, role: '次面板', note: 'blockquote 等次要色塊底' },
  { v: '--chip', num: 600, role: 'Chip 底', note: '標籤膠囊預設狀態' },
  { v: '--chip-hi', num: 500, role: 'Chip hover', note: '標籤膠囊 hover／目前頁 nav' },
  { v: '--card', num: 100, role: '內容卡片', note: '圖集卡／文章卡／連結卡——全站唯一淺色卡片底，只放黑字' },
];
const MUTED = { v: '--mut', role: '次要文字（去飽和・off-ramp）', note: '深紅背景（--bg/--panel/--chip）上的次要文字，故意降飽和度製造「次要」的視覺層級，不算進主 ramp 的編號' };

const HERO = [
  {
    v: '--bg', zh: '哥德紅', en: 'Gothic Red', dark: true,
    note: '取樣自〈狂三 禮服〉#78990595 的禮服主色——全站唯一的錨點紅，其餘色階都從這裡往深、往淺推導。',
  },
  {
    v: '--gold', zh: '時鐘金', en: 'Clockwork Gold', dark: false,
    note: '狂三左眼的時鐘——全站唯一被允許當「重點色」的顏色，只在深紅系背景上用，卡片上讓位給黑字。',
  },
];

const NEUTRAL: { v: string; role: string; note: string }[] = [
  { v: '--accent', role: '純黑・結構強調', note: '線段／邊框／badge／按鈕底——不是「更深的紅」，是刻意跳出色相的純黑，狂三黑振袖的語言' },
  { v: '--ink', role: '純白・主文字', note: '深紅系背景上的主文字' },
];

// 對比配對：fg/bg 是 token 名稱（不含 --），needs=null 表示只是相鄰色塊比較（非疊字），不判定 AA
const PAIRS: { fg: string; bg: string; needs: number | null; label: string }[] = [
  { fg: 'ink', bg: 'bg', needs: 4.5, label: '白字 · 頁面主牆' },
  { fg: 'gold', bg: 'bg', needs: 4.5, label: '金字 · 頁面主牆' },
  { fg: 'mut', bg: 'bg', needs: 4.5, label: '次要字 · 頁面主牆' },
  { fg: 'ink', bg: 'panel', needs: 4.5, label: '白字 · 次面板' },
  { fg: 'gold', bg: 'panel', needs: 4.5, label: '金字 · 次面板' },
  { fg: 'gold', bg: 'chip', needs: 4.5, label: '金字 · Chip' },
  { fg: 'ink', bg: 'chip', needs: 4.5, label: '白字 · Chip' },
  { fg: 'accent', bg: 'card', needs: 4.5, label: '黑字 · 卡片' },
  { fg: 'mut-card', bg: 'card', needs: 4.5, label: '次要字 · 卡片' },
  { fg: 'accent-hi', bg: 'card', needs: 4.5, label: 'Hover 深紅字 · 卡片' },
  { fg: 'ink', bg: 'card', needs: 4.5, label: '✕ 白字 · 卡片（示範不可用）' },
  { fg: 'gold', bg: 'card', needs: 4.5, label: '✕ 金字 · 卡片（示範不可用）' },
];

// OKLCH 驗算快照（scripts/oklch-audit.py，2026-08-06）——固定色相對比，非即時計算。
// ΔE 是跟「色相完全對齊錨點 --bg」的假想版本比，數字越小代表色相越貼。
const OKLCH_AUDIT = [
  { v: '--accent-hi', oklch: 'L0.19 C0.06 H25.4°', de: '0.00', verdict: 'pass', note: '完全同色相' },
  { v: '--mut-card', oklch: 'L0.25 C0.08 H25.7°', de: '0.13', verdict: 'pass', note: '完全同色相' },
  { v: '--bg', oklch: 'L0.33 C0.10 H24.9°', de: '—', verdict: 'pass', note: '錨點本身' },
  { v: '--panel', oklch: 'L0.36 C0.11 H25.0°', de: '0.00', verdict: 'pass', note: '完全同色相' },
  { v: '--chip', oklch: 'L0.39 C0.12 H25.0°', de: '0.00', verdict: 'pass', note: '完全同色相' },
  { v: '--chip-hi', oklch: 'L0.43 C0.13 H24.7°', de: '0.00', verdict: 'pass', note: '完全同色相' },
  { v: '--mut', oklch: 'L0.72 C0.05 H18.3°', de: '0.43', verdict: 'warn', note: '色相略偏暖，仍在人眼可辨識門檻（JND≈1.0）以下' },
  { v: '--card', oklch: 'L0.76 C0.10 H19.6°', de: '0.94', verdict: 'warn', note: '色相略偏暖，同上、仍在 JND 以下' },
];

// 金色驗算（研究快照，2026-08-06）——哥德／維多利亞古董金、黃銅色票 vs 現行 --gold
const GOLD_AUDIT = [
  { name: '現行 --gold', hex: '#d4af37', oklch: 'L0.77 C0.14 H91°', ratio: '6.08:1', verdict: 'pass', note: '過——這支 hex 本身就是色彩資料庫裡「Gold (metallic)」的通用定義值，不是隨手調的' },
  { name: '古董金 Antique Gold', hex: '#9c7a3c', oklch: 'L0.60 C0.09 H81°', ratio: '3.21:1', verdict: 'fail', note: '不過——哥德色票裡「更道地」的古董金，亮度不夠，當文字會直接失敗' },
  { name: '古董黃銅 Antique Brass', hex: '#cd9575', oklch: 'L0.72 C0.08 H51°', ratio: '4.97:1', verdict: 'warn', note: '過，但色相偏到 H51°——讀起來更像玫瑰金／銅，不是金' },
  { name: '傳統黃銅 Classic Brass', hex: '#b5a642', oklch: 'L0.72 C0.12 H101°', ratio: '5.18:1', verdict: 'warn', note: '過，色相跟現行很近（H101° vs H91°），是唯一稱得上「同一家族」的替代' },
  { name: '紋章金 Heraldic Or', hex: '#ffd700', oklch: 'L0.89 C0.18 H95°', ratio: '9.12:1', verdict: 'warn', note: '過，但太亮太飽和——變成「獎盃金」，跟「金是稀缺點綴」的原則衝突' },
];

// 目前還沒收進 token 系統、散在 global.css 各處的紅／金 hex——供未來整併參考
const BACKLOG = [
  { hex: '#f0c850', where: '.search button:hover', note: '金的 hover 態，目前沒有對應 token（--gold 只有一階）' },
  { hex: '#4a1010', where: '.who-note / .prose pre 背景', note: '介於 --mut-card 與 --bg 之間的深紅色塊，未命名' },
  { hex: '#7a1414', where: '.search input::placeholder', note: '很接近 --chip，可能可以直接改用 var(--chip)' },
  { hex: '#5a0e0e', where: '.who-card h3 span', note: '卡片上的極深紅小字，未命名' },
];
---

<Layout title="Brand Guide" active="brand" description="STUDIO MAOCHINN 品牌與色彩規範——狂三紅色系的唯一真源">
  <section class="bg-intro">
    <p class="bg-eyebrow">STUDIO MAOCHINN</p>
    <h1>Brand Guide</h1>
    <p class="bg-lede">
      這頁是全站顏色的<b>唯一真源</b>。以後要調色，先在這裡定案、量過對比，
      再回填 <code>src/styles/global.css</code> 的 <code>:root</code>。
      下面所有色塊與數字都是即時從目前生效的 CSS 變數算出來的——包含右下角
      <b>🎨 TokenLab</b> 現場試的值——不是寫死的示意圖。
    </p>
  </section>

  <nav class="bg-subnav">
    {SECTIONS.map(({ id, label }) => (
      <a href={`#${id}`}>{label}</a>
    ))}
  </nav>

  <h2 class="sec" id="hero">品牌色 <span>Hero Colors</span></h2>
  <div class="bg-hero-grid">
    {HERO.map(({ v, zh, en, dark, note }) => (
      <div class={`bg-hero-card ${dark ? 'dark' : 'light'}`} style={`background:var(${v})`}>
        <div class="bg-hero-name"><b>{zh}</b><i>{en}</i></div>
        <p>{note}</p>
        <div class="bg-hero-meta">
          <code class="bg-var">{v}</code>
          <span data-hex={v}>—</span>
          <span data-oklch={v}>—</span>
        </div>
      </div>
    ))}
  </div>
  <p class="bg-p">
    只有這兩色有名字，其餘色階走數字系統，不逐階取名——這是 NVIDIA（品牌只講「NVIDIA Green」，
    其餘是 Green 100-900）、Material 3、Radix Colors 這代設計系統的共同做法：
    <b>品牌需要 1-2 個記得住的名字，調色盤需要的是程式讀得懂的規則</b>，兩者不是同一份清單。
  </p>

  <h2 class="sec" id="architecture">色彩架構 <span>Primitive → Semantic → Component</span></h2>
  <p class="bg-p">
    現代設計系統（Material 3、IBM Carbon、Radix Colors、NVIDIA 自家的 Omniverse UI Kit）都不會只列一份顏色，
    而是分三層，讓「換色」跟「換意義」變成兩件互不相干的事：
  </p>
  <div class="bg-arch">
    <div class="bg-arch-col">
      <b>1 · Primitive</b>
      <p>原始色階，只回答「這是第幾階的紅」，不帶語意。下面的 <code>red-800</code>／<code>red-100</code> 那排。</p>
    </div>
    <div class="bg-arch-col">
      <b>2 · Semantic</b>
      <p>幫 Primitive 取一個「用途」名字——本站 <code>global.css</code> 現在的做法：<code>--bg</code>、<code>--card</code>、<code>--chip</code>。</p>
    </div>
    <div class="bg-arch-col">
      <b>3 · Component</b>
      <p>個別元件的專屬例外。本站目前<b>沒有</b>這層——按鈕、卡片都直接吃 Semantic token，元件還不夠多，先不強加這層。</p>
    </div>
  </div>

  <h2 class="sec" id="dna">角色調性 <span>Character DNA → Design Principles</span></h2>
  <div class="who">
    <div class="who-card bg-principle">
      <h3>單一色相 <span>ONE HUE</span></h3>
      <p>整套紅落在同一個色相，沒有第二個紅色相偷跑進來。狂三不需要漸層取巧的紅，只需要一種紅，深淺决定語境。</p>
    </div>
    <div class="who-card bg-principle">
      <h3>黑是結構，不是裝飾 <span>BLACK = STRUCTURE</span></h3>
      <p>純黑只做線段、邊框、標記——狂三是「黑振袖 + 紅點綴」，黑色從不大面積鋪底配白字（1.64:1，讀不出來）。</p>
    </div>
    <div class="who-card bg-principle">
      <h3>金是稀缺的 <span>GOLD IS SCARCE</span></h3>
      <p>金＝她左眼的時鐘，全站唯一的強調色與連結色。用多了就不是重點——只在深紅系背景上當文字，卡片上永遠讓位給黑字。</p>
    </div>
    <div class="who-card bg-principle">
      <h3>對比度決定深淺分工 <span>CONTRAST DRIVES THE SPLIT</span></h3>
      <p>紅分兩層不是風格選擇：深紅只能配白字，卡片淡紅只能配黑字。這條線由 WCAG 算出來，不是肉眼喜好。</p>
    </div>
  </div>

  <h2 class="sec" id="ratio">色彩比例 <span>70 · 20 · 10</span></h2>
  <p class="bg-p">深紅為主、黑為結構、金為點綴——這是全站配色的固定比例，不是單一頁面（例如首頁 banner）的局部決定。</p>
  <div class="bg-ratio">
    <div class="bg-ratio-seg" style="flex:70; background:var(--bg);">
      <b>70%</b><span>紅 · 主牆／面板／卡片</span>
    </div>
    <div class="bg-ratio-seg" style="flex:20; background:var(--accent); color:#fff;">
      <b>20%</b><span>黑 · header／線段／結構</span>
    </div>
    <div class="bg-ratio-seg" style="flex:10; background:var(--gold);">
      <b>10%</b><span>金 · 重點字／連結</span>
    </div>
  </div>
  <p class="bg-p bg-note">
    <b>10% 這個數字有出處，不是隨口喊的。</b>設計界通用的
    <a href="https://www.freecodecamp.org/news/the-60-30-10-rule-in-design/" target="_blank" rel="noopener">60-30-10 法則</a>
    （源自室內設計，被 UI／網頁設計整套借用）就是「主色 60%、次色 30%、強調色 10%」——
    強調色故意壓在一成上下，用多了就不再是「強調」，會變成雜訊。本站把主色從 60% 拉到
    70%（紅本來就是這站的主體，不是純背景），次色相應壓到 20%，但<b>強調色仍然卡在標準的 10%</b>
    ——這條數字是站得住腳的，不是這次順口定的。
  </p>

  <h2 class="sec" id="scale">Primitive Scale <span>Kurumi Red · 深→淺</span></h2>
  <p class="bg-p">
    這套紅色 token 是分好幾個月、憑肉眼陸續調出來的——但驗算下來，除了 <code>--mut</code>
    刻意去飽和之外，全部落在同一個色相，天生就是一條 ramp。按明度由深到淺編號
    （越大越深，仿 Tailwind／Radix 的數字系統），之後要加新色階，沿這條線內插，不要另開色相。
    <code>100</code> 到 <code>500</code> 之間刻意留白——現在沒有中間色階的實際需求，寫死一個沒人用的值沒意義。
  </p>
  <div class="bg-swatches">
    {RAMP.map(({ v, num, role, note }) => (
      <div class="bg-swatch">
        <div class="bg-swatch-color" style={`background:var(${v})`}>
          <span class="bg-num">{num}</span>
        </div>
        <div class="bg-swatch-info">
          <code class="bg-var">{v}</code>
          <b>{role}</b>
          <span class="bg-hex" data-hex={v}>—</span>
          <span class="bg-oklch" data-oklch={v}>—</span>
          <p>{note}</p>
        </div>
      </div>
    ))}
  </div>

  <p class="bg-p bg-note">
    <b>{MUTED.v}</b>（{MUTED.role}）——{MUTED.note}。明度介在 ramp 中段，但彩度明顯較低，
    所以獨立列出，不強行塞進主 ramp 的編號裡。
  </p>
  <div class="bg-swatches bg-swatches-sm">
    <div class="bg-swatch">
      <div class="bg-swatch-color" style={`background:var(${MUTED.v})`}></div>
      <div class="bg-swatch-info">
        <code class="bg-var">{MUTED.v}</code>
        <b>{MUTED.role}</b>
        <span class="bg-hex" data-hex={MUTED.v}>—</span>
        <span class="bg-oklch" data-oklch={MUTED.v}>—</span>
      </div>
    </div>
  </div>

  <h2 class="sec" id="neutrals">中性色 <span>Neutrals</span></h2>
  <div class="bg-swatches bg-swatches-sm">
    {NEUTRAL.map(({ v, role, note }) => (
      <div class="bg-swatch">
        <div class="bg-swatch-color" style={`background:var(${v}); border:1px solid #444;`}></div>
        <div class="bg-swatch-info">
          <code class="bg-var">{v}</code>
          <b>{role}</b>
          <span class="bg-hex" data-hex={v}>—</span>
          <p>{note}</p>
        </div>
      </div>
    ))}
  </div>

  <h2 class="sec" id="gold">金色驗算 <span>Gold · 哥德／維多利亞金屬金比對</span></h2>
  <p class="bg-p">
    紅色查完之後，同一輪也查了金色——哥德／維多利亞調性常見的「古董金」「黃銅」色票，
    以及 <code>#d4af37</code> 這個 hex 本身在色彩資料庫裡的定位。結果跟紅色是相似的結論，
    但理由不一樣：這次不是「色相剛好落在同一區」，是<b>更「道地」的古董金在目前的用法下直接掛掉</b>。
  </p>
  <table class="bg-table">
    <thead><tr><th>候選</th><th>Hex</th><th>OKLCH</th><th>金字 · 頁面主牆</th><th>結論</th></tr></thead>
    <tbody>
      {GOLD_AUDIT.map(({ name, hex, oklch, ratio, verdict, note }) => (
        <tr>
          <td><span class="bg-chip-hex" style={`background:${hex}`}></span>{name}</td>
          <td><code>{hex}</code></td>
          <td class="bg-ratio-cell">{oklch}</td>
          <td class="bg-ratio-cell">{ratio}</td>
          <td class={`bg-pass-cell ${verdict}`}>{note}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="bg-p bg-note">
    結論：更「道地」的哥德古董金（Antique Gold）在現在的用法下（深紅背景上當文字）直接不過 AA，
    要把它拉亮到能用，就會失去它「暗啞、做舊」的性格——等於繞一圈又回到現行 <code>#d4af37</code>
    所在的亮度區間。現行金色沒有動：它本來就同時滿足「讀起來像古董金」跟「當文字能過 AA」，
    這兩個條件在候選裡沒有別的 hex 同時滿足。
  </p>

  <h2 class="sec" id="inuse">在真實介面中 <span>In Real UI · 不是重畫的示意圖</span></h2>
  <p class="bg-p">
    下面這些不是照色票重畫的 mockup——用的是 <code>global.css</code> 裡真正的
    <code>.g-card</code>／<code>.p-card</code>／<code>.chip</code>／<code>.btn</code> class，
    跟首頁、圖集頁、部落格頁是同一份 CSS。改了 token，這裡跟正式頁面會同時變。
  </p>
  <div class="bg-inuse">
    <div class="g-card bg-inuse-card">
      <div class="cover">
        <div class="text-cover">
          <b class="tc-title">〈狂三 禮服〉Brand Guide 示範封面</b>
          <i class="tc-mark">Studio Maochinn</i>
        </div>
        <span class="badge">R15</span>
      </div>
      <div class="cap">.g-card ＋ .text-cover——無圖文章用的純文字封面</div>
    </div>
    <div class="p-card bg-inuse-pcard">
      <div class="p-title">.p-card 部落格文章卡片標題示範</div>
