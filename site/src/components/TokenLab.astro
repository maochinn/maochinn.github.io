---
// 🎨 開發用即時 token 調色盤 —— 只在 dev 出現（import.meta.env.DEV），正式 build 不含。
// 直接改 :root 的 CSS 變數即時預覽；localStorage 記住、跨頁保留；Copy CSS 匯出目前值貼給 Claude。
const TOKENS: [string, string][] = [
  ['--bg', '深紅牆／頁背景'],
  ['--panel', '深紅次面板'],
  ['--card', '亮紅卡片／header'],
  ['--stripe', '黑線／條標（=line/accent）'],
  ['--gold', '金：重點字／連結'],
  ['--ink', '白字（深底上用）'],
  ['--mut', '次要字（深底）'],
  ['--mut-card', '次要字（卡片上）'],
  ['--chip', 'chip 底'],
  ['--chip-hi', 'chip hover'],
];
---
{
  import.meta.env.DEV && (
    <div id="tokenlab" data-tokens={JSON.stringify(TOKENS)}>
      <button id="tl-toggle" type="button">🎨 tokens</button>
      <div id="tl-body" hidden>
        <div id="tl-rows" />
        <div class="tl-btns">
          <button id="tl-copy" type="button">Copy CSS</button>
          <button id="tl-reset" type="button">Reset</button>
        </div>
        <textarea id="tl-out" readonly hidden />
      </div>
      <style is:inline>
  #tokenlab { position: fixed; right: 12px; bottom: 12px; z-index: 9999; font: 12px/1.4 system-ui, sans-serif; }
  #tl-toggle { background: #000; color: #fff; border: 1px solid #fff; border-radius: 5px; padding: 7px 11px; cursor: pointer; font-weight: 700; }
  #tl-body { position: absolute; right: 0; bottom: 40px; width: 262px; max-height: 72vh; overflow: auto; background: #151515; border: 1px solid #555; border-radius: 7px; padding: 11px; box-shadow: 0 10px 34px rgba(0,0,0,.65); }
  #tl-body[hidden] { display: none; }
  .tl-row { display: flex; align-items: center; gap: 7px; margin: 5px 0; }
  .tl-row input[type=color] { width: 28px; height: 24px; padding: 0; border: 1px solid #444; background: none; cursor: pointer; flex: 0 0 auto; }
  .tl-row input[type=text] { width: 66px; background: #000; color: #eee; border: 1px solid #444; border-radius: 3px; padding: 2px 5px; font: 11px monospace; flex: 0 0 auto; }
  .tl-row span { flex: 1; color: #ddd; font-size: 11px; }
  .tl-row code { display: block; color: #888; font-size: 10px; }
  .tl-btns { display: flex; gap: 6px; margin-top: 9px; }
  .tl-btns button { flex: 1; background: #333; color: #fff; border: 1px solid #555; border-radius: 3px; padding: 6px; cursor: pointer; font-weight: 700; }
  #tl-out { width: 100%; height: 130px; margin-top: 7px; background: #000; color: #7f7; border: 1px solid #444; border-radius: 3px; font: 10px monospace; }
  #tl-out[hidden] { display: none; }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('tokenlab');
    if (!el) return;
    var KEY = 'tokenlab-overrides';
    var root = document.documentElement;
    var saved = JSON.parse(localStorage.getItem(KEY) || '{}');
    Object.keys(saved).forEach(function (k) { root.style.setProperty(k, saved[k]); });
    var TOKENS = JSON.parse(el.dataset.tokens);
    var rows = document.getElementById('tl-rows');
    function cur(name) {
      var v = saved[name] || getComputedStyle(root).getPropertyValue(name) || '';
      return v.trim() || '#000000';
    }
    TOKENS.forEach(function (t) {
      var name = t[0], label = t[1], v = cur(name);
      var row = document.createElement('div');
      row.className = 'tl-row';
      row.innerHTML = '<input type="color"><input type="text"><span>' + label + '<code>' + name + '</code></span>';
      var cp = row.children[0], tx = row.children[1];
      cp.value = v; tx.value = v;
      function set(val) {
        root.style.setProperty(name, val);
        saved[name] = val;
        localStorage.setItem(KEY, JSON.stringify(saved));
        cp.value = val; tx.value = val;
      }
      cp.addEventListener('input', function () { set(cp.value); });
      tx.addEventListener('change', function () { set(tx.value.trim()); });
      rows.appendChild(row);
    });
    document.getElementById('tl-toggle').addEventListener('click', function () {
      var b = document.getElementById('tl-body');
      b.hidden = !b.hidden;
    });
    document.getElementById('tl-reset').addEventListener('click', function () {
      localStorage.removeItem(KEY);
      location.reload();
    });
    document.getElementById('tl-copy').addEventListener('click', function () {
      var out = document.getElementById('tl-out');
      out.hidden = false;
      var keys = Object.keys(saved);
      var css = keys.length
        ? ':root{\n' + keys.map(function (k) { return '  ' + k + ': ' + saved[k] + ';'; }).join('\n') + '\n}'
        : '（還沒改任何 token）';
      out.value = css;
      out.select();
      if (navigator.clipboard) navigator.clipboard.writeText(css).catch(function () {});
    });
  })();
      </script>
    </div>
  )
}
